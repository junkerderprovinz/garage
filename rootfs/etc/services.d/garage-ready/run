#!/command/with-contenv sh
# shellcheck shell=sh
# =============================================================================
# garage-ready — print a loud "GARAGE IS READY" banner to the container log
# once both Garage's admin API and garage-webui answer, so the user knows the
# first start has finished. House standard: every own-image container prints
# an "<APP> IS READY" log banner as the final block.
# =============================================================================
FLAG=/run/garage-ready.printed

# /run is tmpfs (wiped on every container start) -> the banner prints once/start.
if [ -f "$FLAG" ]; then
    exec sleep infinity
fi

ready=0
i=0
while [ "$i" -lt 150 ]; do
    if curl -fsS http://127.0.0.1:3903/health >/dev/null 2>&1; then
        ready=1
        break
    fi
    i=$((i + 1))
    sleep 2
done

webui_ready=0
j=0
while [ "$j" -lt 60 ]; do
    if curl -fsS http://127.0.0.1:3909 >/dev/null 2>&1; then
        webui_ready=1
        break
    fi
    j=$((j + 1))
    sleep 1
done

# House init-log banner as the final block, directly above the READY box.
/usr/local/bin/print-banner.sh "Garage" "S3-compatible object storage + web admin UI, plug-and-play for Unraid"

# Colored via plain ANSI SGR codes, not tput (tput needs a terminfo database
# that may not exist in a minimal container): 32 green / 33 yellow / 31 red,
# 0 reset. docker logs passes stdout bytes through untouched, so any
# ANSI-aware viewer (a real terminal, Unraid's log panel) renders the color;
# a viewer that does not understand SGR codes just shows them as inert text.
# printf '%b', not "echo -e": this script is POSIX sh, where -e is not
# portable.
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

# Clean one-line-per-service status (house look: no rule/box walls, label +
# detail on the same line). print-banner.sh already left one blank line
# above this. The S3 API and the web admin UI are two separate services, so
# up to two status lines can appear -- each still fully combined to one line.
if [ "$ready" -eq 1 ]; then
    printf '%b\n' "  ${GREEN}✓ GARAGE IS READY${NC} - S3 API is serving on port 3900"
    if [ "$webui_ready" -eq 1 ]; then
        printf '%b\n' "  ${GREEN}✓ WEBUI IS READY${NC} - admin panel is serving on port 3909"
    else
        printf '%b\n' "  ${YELLOW}! WEBUI DID NOT BECOME READY${NC} - check the log above"
    fi
else
    printf '%b\n' "  ${RED}✗ GARAGE DID NOT BECOME READY${NC} - admin API /health never answered within 5 min, check the log above"
fi
echo ""

: > "$FLAG"
# Longrun: stay up so s6 does not restart us and re-print the banner.
exec sleep infinity
