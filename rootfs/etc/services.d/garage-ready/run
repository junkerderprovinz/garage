#!/command/with-contenv sh
# shellcheck shell=sh
# Prints the "GARAGE IS READY" status to the container log once Garage's admin
# API and garage-webui answer, so the user knows the first start has finished.
# Every own-image container ends its log with an "<APP> IS READY" block.
FLAG=/run/garage-ready.printed

# /run is a tmpfs wiped on every container start, so this prints once per start.
if [ -f "$FLAG" ]; then
    exec sleep infinity
fi

ready=0
i=0
while [ "$i" -lt 150 ]; do
    if curl -fsS http://127.0.0.1:3903/health >/dev/null 2>&1; then
        ready=1
        break
    fi
    i=$((i + 1))
    sleep 2
done

webui_ready=0
j=0
while [ "$j" -lt 60 ]; do
    if curl -fsS http://127.0.0.1:3909 >/dev/null 2>&1; then
        webui_ready=1
        break
    fi
    j=$((j + 1))
    sleep 1
done

# House init-log banner as the final block, directly above the status lines.
/usr/local/bin/print-banner.sh "Garage" "S3-compatible object storage + web admin UI, plug-and-play for Unraid"

# Plain ANSI SGR codes rather than tput, which needs a terminfo database a
# minimal container may not have. docker logs passes the bytes through, so an
# ANSI-aware viewer (a terminal, Unraid's log panel) shows the colour. printf
# '%b' because echo -e is not portable in POSIX sh.
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

# One status line per service, label and detail on the same line;
# print-banner.sh already left a blank line above. The S3 API and the web admin
# UI are separate services, so up to two lines appear.
if [ "$ready" -eq 1 ]; then
    printf '%b\n' "  ${GREEN}✓ GARAGE IS READY${NC} - S3 API is serving on port 3900"
    if [ "$webui_ready" -eq 1 ]; then
        printf '%b\n' "  ${GREEN}✓ WEBUI IS READY${NC} - admin panel is serving on port 3909"
    else
        printf '%b\n' "  ${YELLOW}! WEBUI DID NOT BECOME READY${NC} - check the log above"
    fi
else
    printf '%b\n' "  ${RED}✗ GARAGE DID NOT BECOME READY${NC} - admin API /health never answered within 5 min, check the log above"
fi
echo ""

: > "$FLAG"
# Longrun: stay up so s6 does not restart us and re-print the banner.
exec sleep infinity
