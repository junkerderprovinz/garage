#!/command/with-contenv sh
# shellcheck shell=sh
# s6 service: the garage-webui admin panel, started once Garage's admin API is
# reachable.
#
# garage-webui needs Garage's [admin] API (admin_token and api_bind_addr) for
# bucket and key management and cluster status. The admin_token is read from the
# generated /config/garage.toml, so secrets are generated in one place.
#
# The object browser talks S3 directly. Without CONFIG_PATH the webui looks for
# /etc/garage.toml, finds nothing and builds its S3 URL as "http://:".
#
# It waits for the admin API rather than a fixed time; otherwise garage-webui
# starts first and fails its first health check.

PUID="${PUID:-99}"
PGID="${PGID:-100}"

ADMIN_TOKEN=$(sed -n 's/^admin_token = "\(.*\)"$/\1/p' /config/garage.toml)

log_info()  { printf '\033[0;32m[garage-webui] INFO:  %s\033[0m\n' "$*"; }

log_info "Waiting for Garage's admin API on 127.0.0.1:3903 ..."
i=0
until curl -fsS -o /dev/null "http://127.0.0.1:3903/health" 2>/dev/null; do
    i=$((i + 1))
    if [ "$i" -ge 60 ]; then
        echo "[garage-webui] FATAL: Garage admin API never came up after 60s" >&2
        exit 1
    fi
    sleep 1
done
log_info "Garage admin API is up, starting webui"

export API_BASE_URL="http://127.0.0.1:3903"
export API_ADMIN_KEY="${ADMIN_TOKEN}"
export CONFIG_PATH="/config/garage.toml"
export S3_ENDPOINT_URL="http://127.0.0.1:3900"
export PORT="3909"

exec gosu "${PUID}:${PGID}" /usr/local/bin/garage-webui
